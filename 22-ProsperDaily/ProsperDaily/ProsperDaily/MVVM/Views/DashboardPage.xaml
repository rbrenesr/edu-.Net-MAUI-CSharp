<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProsperDaily.MVVM.Views.DashboardPage"
             Title="DashboardPage">


    <Grid RowDefinitions=".15*,.15*,.15*,.55*">
        <RoundRectangle Grid.RowSpan="2"
                        StyleClass="TopRectangle"></RoundRectangle>

        <VerticalStackLayout StyleClass="Header">
            <Label StyleClass="HeaderTitle"
                   Text="Good Morning"></Label>
            <Label StyleClass="HeaderSubTitle"
                   Text="Rafael Brenes"></Label>
        </VerticalStackLayout>

        <Grid Grid.Row="1" Grid.RowSpan="2" StyleClass="BalanceGrid">
            <RoundRectangle StyleClass="BalanceRectangle"></RoundRectangle>

            <Grid ColumnDefinitions="*,*" RowDefinitions=".333*,.333*" StyleClass="Padding25">
                <VerticalStackLayout>
                    <Label Text="Total Balance"></Label>
                    <Label StyleClass="StrongTitle" Text="$15,234.00"></Label>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2">
                    <Label Text="Income"></Label>
                    <Label StyleClass="StrongSubTitle"
                           Text="$15,234.00"></Label>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Expenses"></Label>
                    <Label StyleClass="StrongSubTitle"
                           Text="$15,234.00"></Label>
                </VerticalStackLayout>
            </Grid>
            
        </Grid>

        <Button Grid.Row="2" StyleClass="CircularButton" Text="+"></Button>

        <Grid Grid.Row="3" RowDefinitions=".1*,.9*" StyleClass="Margin15">
            <Label Text="Transacction"></Label>
            <CollectionView Grid.Row="1" EmptyView="No Data">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="15"
                                       Orientation="Vertical">

                    </LinearItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyViewTemplate>
                    <DataTemplate>
                        <Grid>
                            <Label StyleClass="NoDataText"
                                   Text="No data founf, click on the + button do add a new transaction"></Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.EmptyViewTemplate>
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>mono</x:String>
                        <x:String>mono</x:String>
                        <x:String>mono</x:String>
                        <x:String>mono</x:String>
                        <x:String>mono</x:String>
                        <x:String>mono</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                            <Label StyleClass="StrongMediumTitle" Text="Transaction"></Label>
                            <Label Grid.Row="1" StyleClass="SmallFont" Text="Today"></Label>
                            <Label Grid.RowSpan="2" Grid.Column="1" StyleClass="ListAmount" Text="$550.00"></Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        
        
    </Grid>
    
</ContentPage>